# Copy to .env and fill in. .env is git-ignored — never commit real values.

# --- Runtime ---
ENV=development                 # development | production
COMPANY_NAME=AV Group
TIMEZONE=Asia/Kolkata
PUBLIC_UI_URL=http://localhost:3100   # used in QR codes on gate passes

# --- Database (docker-compose builds DATABASE_URL for the api container from these) ---
POSTGRES_USER=boq
POSTGRES_PASSWORD=change-me
POSTGRES_DB=boq_db
# For running the API outside docker (local uvicorn / pytest):
DATABASE_URL=postgresql+asyncpg://boq:change-me@localhost:5436/boq_db
TEST_DATABASE_URL=postgresql+asyncpg://boq:change-me@localhost:5436/boq_test

REDIS_URL=redis://localhost:6380/0

# --- Auth ---
JWT_SECRET=generate-with: python -c "import secrets;print(secrets.token_urlsafe(48))"
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
COOKIE_SECURE=false             # true in production (HTTPS)
CORS_ORIGINS=http://localhost:3100,http://localhost:5173

# --- Seed ---
SEED_ADMIN_EMAIL=admin@avgroup.in
SEED_ADMIN_PASSWORD=change-me-too
# Password for the demo users created by `python -m app.seed --demo` (one per role)
DEMO_PASSWORD=change-me-demo

# --- Business rules ---
GRN_TOLERANCE_PCT=5             # max % a BOQ line may be over-received
MAKER_CHECKER_ON_POSTING=true   # GRN post / Issue post must be done by a different user than the drafter

# --- Uploads ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# --- Email (off in v1) ---
EMAIL_ENABLED=false
